<?xml version="1.0" encoding="UTF-8" ?>
<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing
        https://symfony.com/schema/routing/routing-1.0.xsd">

    <!--
        Le decimos a Symfony que escanee el directorio Storefront/Controller/
        en busca de clases con atributos #[Route].
        El type="attribute" indica que las rutas están definidas como atributos PHP 8.
    -->
    <import resource="../../Storefront/Controller/" type="attribute"/>

</routes>
