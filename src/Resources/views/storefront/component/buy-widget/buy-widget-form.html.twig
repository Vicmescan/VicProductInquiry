{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget-form.html.twig' %}

{% block buy_widget_buy_form_inner %}
    {% if product.customFields.vic_product_inquiry_active %}

        <div class="vic-inquiry-button-container">
            <button
                type="button"
                class="btn btn-primary vic-inquiry-btn"
                data-vic-inquiry-modal="true"
                data-product-id="{{ product.id }}"
                data-product-name="{{ product.translated.name|escape('html_attr') }}"
                data-daily-price="{{ product.calculatedPrice.unitPrice }}">
                {{ 'vic.productInquiry.button.label'|trans|sw_sanitize }}
            </button>
        </div>

        <div class="modal fade"
             id="vicInquiryModal--{{ product.id }}"
             tabindex="-1"
             aria-labelledby="vicInquiryModalLabel--{{ product.id }}"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="vicInquiryModalLabel--{{ product.id }}">
                            {{ 'vic.productInquiry.modal.title'|trans|sw_sanitize }}
                        </h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="{{ 'general.closeModal'|trans|striptags }}">
                        </button>
                    </div>

                    <div class="modal-body">
                        <form class="vic-inquiry-form"
                              action="{{ path('vic.product.inquiry.send') }}"
                              method="post">

                            <input type="hidden" name="productId" value="{{ product.id }}">
                            <input type="hidden" name="productName" value="{{ product.translated.name }}">
                            <input type="hidden" name="dailyPrice" value="{{ product.calculatedPrice.unitPrice }}">
                            <input type="hidden" name="startDate" class="vic-inquiry-start-date">
                            <input type="hidden" name="endDate" class="vic-inquiry-end-date">
                            <input type="hidden" name="rentalDays" class="vic-inquiry-rental-days">
                            <input type="hidden" name="totalPrice" class="vic-inquiry-total-price">

                            <div class="mb-3">
                                <label for="vicInquiryName--{{ product.id }}" class="form-label">
                                    {{ 'vic.productInquiry.modal.form.name'|trans|sw_sanitize }}
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="vicInquiryName--{{ product.id }}"
                                       name="customerName"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="vicInquiryEmail--{{ product.id }}" class="form-label">
                                    {{ 'vic.productInquiry.modal.form.email'|trans|sw_sanitize }}
                                </label>
                                <input type="email"
                                       class="form-control"
                                       id="vicInquiryEmail--{{ product.id }}"
                                       name="customerEmail"
                                       required>
                            </div>

                            {# Selector de fechas de alquiler #}
                            <div class="row mb-3">
                                <div class="col">
                                    <label for="vicStartDate--{{ product.id }}" class="form-label">
                                        {{ 'vic.productInquiry.modal.form.startDate'|trans|sw_sanitize }}
                                    </label>
                                    <input type="date"
                                           class="form-control vic-inquiry-date-start"
                                           id="vicStartDate--{{ product.id }}"
                                           required>
                                </div>
                                <div class="col">
                                    <label for="vicEndDate--{{ product.id }}" class="form-label">
                                        {{ 'vic.productInquiry.modal.form.endDate'|trans|sw_sanitize }}
                                    </label>
                                    <input type="date"
                                           class="form-control vic-inquiry-date-end"
                                           id="vicEndDate--{{ product.id }}"
                                           required>
                                </div>
                            </div>

                            {# Resumen de precio — oculto hasta que se seleccionen ambas fechas #}
                            <div class="vic-inquiry-price-summary alert alert-info d-none mb-3">
                                <div class="d-flex justify-content-between">
                                    <span>{{ 'vic.productInquiry.modal.summary.days'|trans|sw_sanitize }}</span>
                                    <strong class="vic-inquiry-days-display">—</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>{{ 'vic.productInquiry.modal.summary.dailyRate'|trans|sw_sanitize }}</span>
                                    <strong class="vic-inquiry-daily-display">—</strong>
                                </div>
                                <hr class="my-2">
                                <div class="d-flex justify-content-between fs-5">
                                    <strong>{{ 'vic.productInquiry.modal.summary.total'|trans|sw_sanitize }}</strong>
                                    <strong class="vic-inquiry-total-display">—</strong>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="vicInquiryMessage--{{ product.id }}" class="form-label">
                                    {{ 'vic.productInquiry.modal.form.message'|trans|sw_sanitize }}
                                </label>
                                <textarea class="form-control"
                                          id="vicInquiryMessage--{{ product.id }}"
                                          name="message"
                                          rows="3"></textarea>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    {{ 'vic.productInquiry.modal.form.submit'|trans|sw_sanitize }}
                                </button>
                            </div>

                        </form>
                    </div>

                </div>
            </div>
        </div>

    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
